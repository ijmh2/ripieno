{
  "name": "ripieno",
  "displayName": "Ripieno",
  "description": "A self-hosted shared workspace where several people and several AI agents work on one codebase, each attributable.",
  "author": "Ivan Hart (@ijmh2)",
  "version": "0.0.4",
  "publisher": "ijmh2",
  "license": "SEE LICENSE IN LICENSE",
  "preview": true,
  "pricing": "Free",
  "icon": "media/icon.png",
  "homepage": "https://github.com/ijmh2/ripieno#readme",
  "bugs": {
    "url": "https://github.com/ijmh2/ripieno/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Ripieno can launch local coding agents and execute approved workspace tools, so enable it only in a workspace you trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Ripieno agents and workspace tools require a local filesystem-backed workspace."
    }
  },
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ripieno",
          "title": "Ripieno",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "ripieno": [
        {
          "id": "ripieno.rooms",
          "name": "Rooms & Agents"
        },
        {
          "id": "ripieno.room",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "ripieno.workspace",
          "name": "Shared Workspace",
          "when": "ripieno.hasSharedWorkspace"
        }
      ]
    },
    "commands": [
      {
        "command": "ripieno.startSolo",
        "title": "Ripieno: Start a Room for Yourself",
        "icon": "$(play)"
      },
      {
        "command": "ripieno.openRoomPanel",
        "title": "Ripieno: Open Workspace",
        "icon": "$(open-preview)"
      },
      {
        "command": "ripieno.joinRoom",
        "title": "Ripieno: Join Room",
        "icon": "$(sign-in)"
      },
      {
        "command": "ripieno.leaveRoom",
        "title": "Ripieno: Leave Room",
        "icon": "$(sign-out)"
      },
      {
        "command": "ripieno.signIn",
        "title": "Ripieno: Sign in to GitHub"
      },
      {
        "command": "ripieno.attachAgent",
        "title": "Ripieno: Attach an Agent",
        "icon": "$(play)"
      },
      {
        "command": "ripieno.detachAgent",
        "title": "Ripieno: Detach Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ripieno.addAgent",
        "title": "Ripieno: Add Agent",
        "icon": "$(add)"
      },
      {
        "command": "ripieno.customizeAgent",
        "title": "Ripieno: Customize Agent\u2026",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ripieno.removeAgent",
        "title": "Ripieno: Delete Agent\u2026",
        "icon": "$(trash)"
      },
      {
        "command": "ripieno.hostWorkspace",
        "title": "Ripieno: Host / Release the Shared Workspace",
        "icon": "$(root-folder)"
      },
      {
        "command": "ripieno.mountWorkspace",
        "title": "Ripieno: Mount Shared Workspace in Explorer",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "ripieno.proposeChange",
        "title": "Ripieno: Propose Change to Host",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "ripieno.copyInvite",
        "title": "Copy Invite Link",
        "category": "Ripieno",
        "icon": "$(link)"
      },
      {
        "command": "ripieno.setRole",
        "title": "Change Role\u2026",
        "category": "Ripieno"
      },
      {
        "command": "ripieno.addCodeComment",
        "title": "Add Shared Code Comment",
        "category": "Ripieno"
      },
      {
        "command": "ripieno.addSharedMemory",
        "title": "Remember Selection in Brain",
        "category": "Ripieno"
      },
      {
        "command": "ripieno.addSharedPlan",
        "title": "Create Shared Plan",
        "category": "Ripieno"
      }
    ],
    "walkthroughs": [
      {
        "id": "ripieno.getStarted",
        "title": "Get started with Ripieno",
        "description": "A shared room for people and their AI agents, where everything has an author.",
        "steps": [
          {
            "id": "addAgent",
            "title": "Bring your own agent",
            "description": "Attach an agent you already pay for \u2014 Claude Code, Codex, Gemini, or a local model.\n[Add an agent](command:ripieno.addAgent)",
            "media": {
              "markdown": "media/walkthrough/agent.md",
              "altText": "Choosing an agent provider"
            },
            "completionEvents": [
              "onCommand:ripieno.addAgent"
            ]
          },
          {
            "id": "startRoom",
            "title": "Start a room for yourself",
            "description": "No relay, no token, no account \u2014 the extension runs one in this window.\n[Start a room](command:ripieno.startSolo)",
            "media": {
              "markdown": "media/walkthrough/room.md",
              "altText": "A solo room running on loopback"
            },
            "completionEvents": [
              "onCommand:ripieno.startSolo"
            ]
          },
          {
            "id": "attribution",
            "title": "See who did what",
            "description": "Ask your agent something, then open Work under the conversation. Every action names the agent and the machine it ran on.",
            "media": {
              "markdown": "media/walkthrough/attribution.md",
              "altText": "The action log naming agents and machines"
            },
            "completionEvents": [
              "onContext:ripieno.inRoom"
            ]
          },
          {
            "id": "invite",
            "title": "Add a second person",
            "description": "One link. They bring their own agent, and their agent runs on their machine under their permissions.\n[Copy an invite link](command:ripieno.copyInvite)",
            "media": {
              "markdown": "media/walkthrough/approval.md",
              "altText": "An approval card asking permission to run a command"
            },
            "completionEvents": [
              "onCommand:ripieno.copyInvite"
            ]
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "ripieno.rooms",
        "contents": "Bring an agent into this workspace \u2014 Claude Code, Codex, Gemini, or any OpenAI-compatible model.\n\nEach person runs their own, on their own subscription. Nothing is shared and there is no account.\n\n[Add an agent](command:ripieno.addAgent)\n\nThen start a room for yourself \u2014 nothing to deploy.\n\n[Start a room](command:ripieno.startSolo)"
      },
      {
        "view": "ripieno.workspace",
        "contents": "Nobody is hosting a shared workspace.\n\nThe host's folder is the one other members' agents can read, write and run commands in \u2014 always behind an approval on the host's own machine. If no folder is open, Ripieno can create one.\n\n[Host or create a workspace](command:ripieno.hostWorkspace)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ripieno.addAgent",
          "when": "view == ripieno.rooms && ripieno.canAttachAgents",
          "group": "navigation"
        },
        {
          "command": "ripieno.hostWorkspace",
          "when": "view == ripieno.rooms",
          "group": "navigation"
        },
        {
          "command": "ripieno.mountWorkspace",
          "when": "view == ripieno.workspace",
          "group": "navigation"
        },
        {
          "command": "ripieno.openRoomPanel",
          "when": "view == ripieno.room",
          "group": "navigation@0"
        },
        {
          "command": "ripieno.startSolo",
          "when": "view == ripieno.room && !ripieno.inRoom",
          "group": "navigation@1"
        },
        {
          "command": "ripieno.joinRoom",
          "when": "view == ripieno.room && !ripieno.inRoom",
          "group": "navigation"
        },
        {
          "command": "ripieno.copyInvite",
          "when": "view == ripieno.room && ripieno.inRoom",
          "group": "navigation"
        },
        {
          "command": "ripieno.leaveRoom",
          "when": "view == ripieno.room && ripieno.inRoom",
          "group": "1_room@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ripieno.customizeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentDetached",
          "group": "inline@1"
        },
        {
          "command": "ripieno.attachAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentDetached",
          "group": "inline@2"
        },
        {
          "command": "ripieno.customizeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentError",
          "group": "inline@1"
        },
        {
          "command": "ripieno.attachAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentError",
          "group": "inline@2"
        },
        {
          "command": "ripieno.customizeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentAttached",
          "group": "inline@1"
        },
        {
          "command": "ripieno.detachAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentAttached",
          "group": "inline@2"
        },
        {
          "command": "ripieno.removeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentDetached",
          "group": "2_manage@9"
        },
        {
          "command": "ripieno.removeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentError",
          "group": "2_manage@9"
        },
        {
          "command": "ripieno.removeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentAttached",
          "group": "2_manage@9"
        },
        {
          "command": "ripieno.customizeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentDetachedReadOnly",
          "group": "inline@1"
        },
        {
          "command": "ripieno.removeAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentDetachedReadOnly",
          "group": "2_manage@9"
        },
        {
          "command": "ripieno.setRole",
          "when": "view == ripieno.rooms && viewItem == ripienoMemberManageable",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "ripieno.proposeChange",
          "when": "ripieno.hasSharedWorkspace",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ripieno.addCodeComment",
          "group": "ripieno",
          "when": "editorHasSelection"
        },
        {
          "command": "ripieno.addSharedMemory",
          "group": "ripieno",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Ripieno",
      "properties": {
        "ripieno.relayUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "WebSocket URL of the relay hosting the room. Remote relays must use `wss://`; plaintext `ws://` is accepted only on loopback.\n\n**Leave empty to work solo** \u2014 the extension runs a relay on this machine, so a room needs no server, no token and no second person. Set a URL when you want other people in the room with you."
        },
        "ripieno.commandApproval": {
          "type": "string",
          "enum": [
            "always",
            "allowlist",
            "never"
          ],
          "enumDescriptions": [
            "Confirm every command.",
            "Run commands matching ripieno.allowedCommands without asking; confirm the rest.",
            "Run any command without asking. A shared room can then execute anything on your machine."
          ],
          "default": "always",
          "description": "When to confirm before the agent runs a shell command in your workspace."
        },
        "ripieno.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git status",
            "git diff",
            "npm test",
            "npm run build"
          ],
          "description": "Command prefixes that run without confirmation when ripieno.commandApproval is \"allowlist\". A command containing shell separators is never matched."
        },
        "ripieno.agentPermissions": {
          "type": "string",
          "enum": [
            "ask",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "Your agent asks you before anything with side effects \u2014 running code, launching apps, git writes. The prompt appears in your editor, so it is a real decision rather than a stalled request.",
            "Your agent runs everything without asking, like an ordinary Claude Code session. Remember the room steers it: anyone in the room can talk your agent into running things on your machine."
          ],
          "default": "ask",
          "markdownDescription": "Fallback for older Claude agents without a per-agent permission choice. New agents are adjusted from the gear beside their row in Rooms & Agents. `ask` routes approvals to you; `bypassPermissions` is only appropriate in a room you trust."
        },
        "ripieno.sharePrivateWorkspacePresence": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Share exact file and line locations for your agents when they work outside the room's shared workspace. **Off by default:** enabling this exposes private workspace-relative paths to everyone in the room. Other members can see the location but cannot open or decorate it; only your editor maps it to your local files."
        },
        "ripieno.devIdentityOverride": {
          "type": "string",
          "default": "",
          "description": "Development only. Join as this handle instead of your GitHub account, so a second window can act as another member. Leave empty in normal use."
        },
        "ripieno.devDisplayNameOverride": {
          "type": "string",
          "default": "",
          "description": "Development only. Display name to pair with ripieno.devIdentityOverride."
        },
        "ripieno.roomToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Legacy/configuration fallback for the shared relay gate. Invite tokens are kept in SecretStorage and scoped to their relay. Leave empty for embedded solo mode. This is a gate, not a login \u2014 without identity verification a holder can still claim any handle."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.js && node --test test/*.test.js",
    "test:extension-host": "node test-host/run.js",
    "package": "mkdir -p ../../dist && vsce package --no-dependencies --out ../../dist/",
    "publish:marketplace": "vsce publish --no-dependencies",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ripieno/relay": "*",
    "@ripieno/relay-client": "*",
    "@ripieno/workspace-core": "*",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.85.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ijmh2/ripieno.git"
  },
  "keywords": [
    "ai",
    "agent",
    "collaboration",
    "provenance",
    "attribution",
    "self-hosted"
  ]
}
