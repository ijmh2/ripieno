{
  "name": "ripieno",
  "displayName": "Ripieno",
  "description": "A self-hosted shared workspace where several people and several AI agents work on one codebase, each attributable.",
  "version": "0.0.1",
  "publisher": "ijmh2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ripieno",
          "title": "Ripieno",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "ripieno": [
        {
          "id": "ripieno.rooms",
          "name": "Rooms & Agents"
        },
        {
          "id": "ripieno.room",
          "name": "Room",
          "type": "webview"
        },
        {
          "id": "ripieno.workspace",
          "name": "Shared Workspace",
          "when": "ripieno.hasSharedWorkspace"
        }
      ]
    },
    "commands": [
      {
        "command": "ripieno.joinRoom",
        "title": "Ripieno: Join Room"
      },
      {
        "command": "ripieno.leaveRoom",
        "title": "Ripieno: Leave Room"
      },
      {
        "command": "ripieno.signIn",
        "title": "Ripieno: Sign in to GitHub"
      },
      {
        "command": "ripieno.attachAgent",
        "title": "Ripieno: Attach an Agent",
        "icon": "$(play)"
      },
      {
        "command": "ripieno.detachAgent",
        "title": "Ripieno: Detach Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ripieno.addAgent",
        "title": "Ripieno: Add Another Agent",
        "icon": "$(add)"
      },
      {
        "command": "ripieno.hostWorkspace",
        "title": "Ripieno: Host / Release the Shared Workspace",
        "icon": "$(root-folder)"
      },
      {
        "command": "ripieno.mountWorkspace",
        "title": "Ripieno: Mount Shared Workspace in Explorer",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "ripieno.proposeChange",
        "title": "Ripieno: Propose Change to Host",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "ripieno.copyInvite",
        "title": "Copy Invite Link",
        "category": "Ripieno"
      },
      {
        "command": "ripieno.setRole",
        "title": "Change Role\u2026",
        "category": "Ripieno"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ripieno.addAgent",
          "when": "view == ripieno.rooms",
          "group": "navigation"
        },
        {
          "command": "ripieno.hostWorkspace",
          "when": "view == ripieno.rooms",
          "group": "navigation"
        },
        {
          "command": "ripieno.mountWorkspace",
          "when": "view == ripieno.workspace",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ripieno.attachAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentDetached",
          "group": "inline"
        },
        {
          "command": "ripieno.detachAgent",
          "when": "view == ripieno.rooms && viewItem == ripienoAgentAttached",
          "group": "inline"
        },
        {
          "command": "ripieno.setRole",
          "when": "view == ripieno.rooms && viewItem == ripienoMemberManageable",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "ripieno.proposeChange",
          "when": "ripieno.hasSharedWorkspace",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ripieno",
      "properties": {
        "ripieno.relayUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "WebSocket URL of the relay hosting the room.\n\n**Leave empty to work solo** \u2014 the extension runs a relay on this machine, so a room needs no server, no token and no second person. Set a URL when you want other people in the room with you."
        },
        "ripieno.commandApproval": {
          "type": "string",
          "enum": [
            "always",
            "allowlist",
            "never"
          ],
          "enumDescriptions": [
            "Confirm every command.",
            "Run commands matching ripieno.allowedCommands without asking; confirm the rest.",
            "Run any command without asking. A shared room can then execute anything on your machine."
          ],
          "default": "always",
          "description": "When to confirm before the agent runs a shell command in your workspace."
        },
        "ripieno.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git status",
            "git diff",
            "npm test",
            "npm run build"
          ],
          "description": "Command prefixes that run without confirmation when ripieno.commandApproval is \"allowlist\". A command containing shell separators is never matched."
        },
        "ripieno.agentPermissions": {
          "type": "string",
          "enum": [
            "ask",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "Your agent asks you before anything with side effects \u2014 running code, launching apps, git writes. The prompt appears in your editor, so it is a real decision rather than a stalled request.",
            "Your agent runs everything without asking, like an ordinary Claude Code session. Remember the room steers it: anyone in the room can talk your agent into running things on your machine."
          ],
          "default": "ask",
          "markdownDescription": "What your own agents may do in a room. `ask` routes approvals to you in the editor and is the sane default; `bypassPermissions` is faster and only appropriate in a room you trust."
        },
        "ripieno.devIdentityOverride": {
          "type": "string",
          "default": "",
          "description": "Development only. Join as this handle instead of your GitHub account, so a second window can act as another member. Leave empty in normal use."
        },
        "ripieno.devDisplayNameOverride": {
          "type": "string",
          "default": "",
          "description": "Development only. Display name to pair with ripieno.devIdentityOverride."
        },
        "ripieno.roomToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Shared secret required by a deployed relay. Leave empty for a local relay. This is a gate, not a login \u2014 a holder can still claim any handle, so treat it as the key to the whole room."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.js && node --test test/*.test.js",
    "package": "mkdir -p ../../dist && vsce package --no-dependencies --out ../../dist/",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0",
    "@ripieno/workspace-core": "*",
    "@ripieno/relay-client": "*",
    "@ripieno/relay": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.23.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ijmh2/ripieno.git"
  },
  "keywords": [
    "ai",
    "agent",
    "collaboration",
    "provenance",
    "attribution",
    "self-hosted"
  ]
}
